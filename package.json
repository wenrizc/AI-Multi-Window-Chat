{
  "name": "ai-multi-window-extension",
  "version": "2.0.0",
  "description": "AI Multi-Window Extension",
  "keywords": [
    "ai",
    "chat",
    "chrome-extension",
    "browser-extension",
    "openai",
    "gpt",
    "assistant",
    "multi-window",
    "productivity",
    "chatgpt",
    "llm"
  ],
  "author": "wenrizc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wenrizc/AI-Multi-Window-Chat.git"
  },
  "bugs": {
    "url": "https://github.com/wenrizc/AI-Multi-Window-Chat/issues"
  },
  "homepage": "https://github.com/wenrizc/AI-Multi-Window-Chat#readme",
  "scripts": {
    "build": "node build.mjs --release",
    "build:watch": "node build.mjs --watch",
    "build:website": "node scripts/build-website.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@copilotkit/aimock": "^1.27.3",
    "@playwright/test": "^1.58.0",
    "@types/chrome": "^0.1.42",
    "@types/node": "^25.9.0",
    "@vitest/browser": "^5.0.2",
    "@vitest/browser-playwright": "^5.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "msw": "^2.14.6",
    "playwright": "^1.58.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "katex": "^0.16.27",
    "marked": "^17.0.1",
    "marked-katex-extension": "^5.1.6"
  }
